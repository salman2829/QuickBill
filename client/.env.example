# FRONTEND ONLY - copy to client/.env then run: npm run sync:config
# /api = same origin (recommended for Vercel full deploy)
# Or set a Render URL like: https://your-service.onrender.com/api

API_BASE_URL=/api

# Note: The client typically communicates with the backend, but if direct access is configured:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
GEMINI_API_KEY=your_gemini_api_key
